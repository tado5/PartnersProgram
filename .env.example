NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Required: fill locally. See README.md for connection URL formats.
DATABASE_URL=
MIGRATE_DATABASE_URL=
SHADOW_DATABASE_URL=
TEST_DATABASE_URL=
# Required: use distinct, randomly generated database passwords.
MARIADB_ROOT_PASSWORD=
DB_APP_PASSWORD=
DB_MIGRATE_PASSWORD=
# Required: generate with openssl rand -hex 32.
AUTH_SECRET=
# Dedicated key for reopening QR/NFC tokens: openssl rand -hex 32.
# Keep stable across deployments; back up separately from the database.
TOKEN_ENCRYPTION_KEY=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Local-only development shortcut; production rejects this setting.
LOCAL_QUICK_LOGIN_ENABLED=true
SESSION_SELLER_IDLE_MINUTES=60
SESSION_SELLER_MAX_HOURS=10
SESSION_ADMIN_IDLE_MINUTES=30
SESSION_ADMIN_MAX_HOURS=8
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SELLER_EMAIL=
SEED_SELLER_PASSWORD=
RATE_LIMIT_PUBLIC_PER_MIN=30
RATE_LIMIT_LOGIN_PER_MIN=10
BADGE_CRON_SECRET=
APP_TIMEZONE=Europe/Bratislava
NEXT_TELEMETRY_DISABLED=1
