generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  directUrl         = env("MIGRATE_DATABASE_URL")
}

enum UserRole {
  admin
  seller
  superadmin
}

enum PartnerType {
  installer
  company
  referrer
}

enum TokenType {
  qr
  nfc
}

enum PurchaseSource {
  qr
  nfc
  manual
}

enum PartnerBadgeTier {
  bronze
  silver
  gold
}

enum MonetaryBasis {
  gross
  net
}

enum PrivacyDeliveryMethod {
  in_person
  printed
  email
}

model Company {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name            String         @db.VarChar(100)
  slug            String         @unique(map: "companies_slug_uq") @db.VarChar(80)
  ico             String?        @db.Char(8)
  logoData        Bytes?         @map("logo_data") @db.MediumBlob
  logoVersion     String?        @map("logo_version") @db.Char(64)
  vatRatePercent Decimal        @default(23.00) @map("vat_rate_percent") @db.Decimal(5, 2)
  purchaseConfirmAboveEur Decimal? @map("purchase_confirm_above_eur") @db.Decimal(10, 2)
  bronzeMonthlyTurnoverEur Decimal? @map("bronze_monthly_turnover_eur") @db.Decimal(10, 2)
  silverMonthlyTurnoverEur Decimal? @map("silver_monthly_turnover_eur") @db.Decimal(10, 2)
  goldMonthlyTurnoverEur Decimal? @map("gold_monthly_turnover_eur") @db.Decimal(10, 2)
  isActive        Boolean        @default(true) @map("is_active")
  deactivatedAt   DateTime?      @map("deactivated_at") @db.DateTime(3)
  createdByUserId BigInt?        @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy       User?          @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  users           User[]         @relation("CompanyMembers")
  partners        Partner[]
  tokens          PartnerToken[]
  purchases       Purchase[]
  badgeAwards     PartnerBadgeAward[]
  auditLogs       AuditLog[]
  privacyDraft    CompanyPrivacyDraft?
  privacyNotices  CompanyPrivacyNotice[]
  privacyReceipts CompanyPrivacyReceipt[]

  @@index([isActive, name], map: "companies_active_name_idx")
  @@map("companies")
}

model User {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  companyId          BigInt?        @map("company_id") @db.UnsignedBigInt
  company            Company?       @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdCompanies   Company[]      @relation("CompanyCreatedBy")
  email              String         @unique(map: "users_email_uq") @db.VarChar(191)
  name               String         @db.VarChar(150)
  passwordHash       String         @map("password_hash") @db.VarChar(255)
  role               UserRole
  isActive           Boolean        @default(true) @map("is_active")
  mustChangePassword Boolean        @default(true) @map("must_change_password")
  failedLoginCount   Int            @default(0) @map("failed_login_count") @db.UnsignedInt
  lockedUntil        DateTime?      @map("locked_until") @db.DateTime(3)
  passwordChangedAt  DateTime?      @map("password_changed_at") @db.DateTime(3)
  lastLoginAt        DateTime?      @map("last_login_at") @db.DateTime(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  createdPartners    Partner[]      @relation("PartnerCreatedBy")
  createdTokens      PartnerToken[] @relation("TokenCreatedBy")
  deactivatedTokens  PartnerToken[] @relation("TokenDeactivatedBy")
  createdPurchases   Purchase[]     @relation("PurchaseCreatedBy")
  updatedPurchases   Purchase[]     @relation("PurchaseUpdatedBy")
  deletedPurchases   Purchase[]     @relation("PurchaseDeletedBy")
  auditLogs          AuditLog[]
  publishedPrivacyNotices CompanyPrivacyNotice[] @relation("PrivacyNoticePublishedBy")
  recordedPrivacyReceipts CompanyPrivacyReceipt[] @relation("PrivacyReceiptRecordedBy")

  @@index([companyId, role, isActive], map: "users_company_role_active_idx")
  @@map("users")
}

model Partner {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  companyId       BigInt         @map("company_id") @db.UnsignedBigInt
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code            String         @unique(map: "partners_code_uq") @db.Char(8)
  type            PartnerType
  displayName     String         @map("display_name") @db.VarChar(100)
  phone           String?        @db.VarChar(20)
  email           String?        @db.VarChar(191)
  contactPerson   String?        @map("contact_person") @db.VarChar(100)
  ico             String?        @db.Char(8)
  internalNote    String?        @map("internal_note") @db.VarChar(1000)
  isActive        Boolean        @default(true) @map("is_active")
  deactivatedAt   DateTime?      @map("deactivated_at") @db.DateTime(3)
  createdByUserId BigInt?        @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy       User?          @relation("PartnerCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tokens          PartnerToken[]
  purchases       Purchase[]
  badgeAwards     PartnerBadgeAward[]
  auditLogs       AuditLog[]
  privacyReceipts CompanyPrivacyReceipt[]

  @@unique([companyId, id], map: "partners_company_id_uq")
  @@index([companyId, isActive, type], map: "partners_company_active_type_idx")
  @@index([companyId, displayName], map: "partners_company_name_idx")
  @@index([companyId, phone], map: "partners_company_phone_idx")
  @@index([companyId, ico], map: "partners_company_ico_idx")
  @@map("partners")
}

model PartnerToken {
  id                  BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  companyId           BigInt     @map("company_id") @db.UnsignedBigInt
  company             Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  partnerId           BigInt     @map("partner_id") @db.UnsignedBigInt
  type                TokenType
  tokenHash           String     @unique(map: "partner_tokens_token_hash_uq") @map("token_hash") @db.Char(64)
  tokenHint           String     @map("token_hint") @db.Char(6)
  label               String?    @db.VarChar(80)
  isActive            Boolean    @default(true) @map("is_active")
  createdByUserId     BigInt?    @map("created_by_user_id") @db.UnsignedBigInt
  createdAt           DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  deactivatedAt       DateTime?  @map("deactivated_at") @db.DateTime(3)
  deactivatedByUserId BigInt?    @map("deactivated_by_user_id") @db.UnsignedBigInt
  deactivationReason  String?    @map("deactivation_reason") @db.VarChar(255)
  lastUsedAt          DateTime?  @map("last_used_at") @db.DateTime(3)
  partner             Partner    @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy           User?      @relation("TokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deactivatedBy       User?      @relation("TokenDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: Restrict)
  purchases           Purchase[]

  @@unique([companyId, id], map: "partner_tokens_company_id_uq")
  @@unique([companyId, partnerId, id], map: "partner_tokens_company_partner_id_uq")
  @@index([companyId, partnerId, isActive], map: "partner_tokens_company_partner_active_idx")
  @@map("partner_tokens")
}

model Purchase {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  companyId       BigInt         @map("company_id") @db.UnsignedBigInt
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  partnerId       BigInt         @map("partner_id") @db.UnsignedBigInt
  amount          Decimal        @db.Decimal(10, 2)
  netAmount       Decimal        @map("net_amount") @db.Decimal(10, 2)
  vatRatePercent  Decimal        @map("vat_rate_percent") @db.Decimal(5, 2)
  points          Int            @db.UnsignedInt
  partnerPresent  Boolean        @map("partner_present")
  note            String?        @db.VarChar(500)
  purchasedAt     DateTime       @default(now()) @map("purchased_at") @db.DateTime(3)
  source          PurchaseSource
  tokenId         BigInt?        @map("token_id") @db.UnsignedBigInt
  idempotencyKey  String?        @map("idempotency_key") @db.Char(36)
  createdByUserId BigInt         @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?        @map("updated_by_user_id") @db.UnsignedBigInt
  isDeleted       Boolean        @default(false) @map("is_deleted")
  deletedAt       DateTime?      @map("deleted_at") @db.DateTime(3)
  deletedByUserId BigInt?        @map("deleted_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  partner         Partner        @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  token           PartnerToken?  @relation(fields: [companyId, partnerId, tokenId], references: [companyId, partnerId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User           @relation("PurchaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User?          @relation("PurchaseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  deletedBy       User?          @relation("PurchaseDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, id], map: "purchases_company_id_uq")
  @@unique([companyId, idempotencyKey], map: "purchases_company_idempotency_uq")
  @@index([companyId, partnerId, isDeleted, purchasedAt], map: "purchases_company_partner_deleted_date_idx")
  @@index([companyId, purchasedAt], map: "purchases_company_date_idx")
  @@index([companyId, createdByUserId, createdAt], map: "purchases_company_creator_date_idx")
  @@index([createdByUserId], map: "purchases_creator_fk_idx")
  @@map("purchases")
}

model PartnerBadgeAward {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  companyId       BigInt    @map("company_id") @db.UnsignedBigInt
  partnerId       BigInt    @map("partner_id") @db.UnsignedBigInt
  periodStart     DateTime  @map("period_start") @db.Date
  tier            PartnerBadgeTier
  monthlyTurnover Decimal   @map("monthly_turnover") @db.Decimal(14, 2)
  thresholdEur    Decimal   @map("threshold_eur") @db.Decimal(10, 2)
  calculationBasis MonetaryBasis @default(gross) @map("calculation_basis")
  awardedAt       DateTime  @default(now()) @map("awarded_at") @db.DateTime(3)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  partner         Partner   @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, partnerId, periodStart], map: "partner_badge_awards_company_partner_period_uq")
  @@index([companyId, periodStart, tier], map: "partner_badge_awards_company_period_tier_idx")
  @@map("partner_badge_awards")
}

model CompanyPrivacyDraft {
  companyId         BigInt   @id @map("company_id") @db.UnsignedBigInt
  controllerName    String   @map("controller_name") @db.VarChar(150)
  controllerAddress String   @map("controller_address") @db.VarChar(500)
  controllerIco     String?  @map("controller_ico") @db.VarChar(8)
  contactEmail      String   @map("contact_email") @db.VarChar(191)
  dpoContact        String?  @map("dpo_contact") @db.VarChar(500)
  body              String   @db.Text
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "company_privacy_drafts_company_fk")

  @@map("company_privacy_drafts")
}

model CompanyPrivacyNotice {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId         BigInt   @map("company_id") @db.UnsignedBigInt
  version           Int      @db.UnsignedInt
  controllerName    String   @map("controller_name") @db.VarChar(150)
  controllerAddress String   @map("controller_address") @db.VarChar(500)
  controllerIco     String?  @map("controller_ico") @db.VarChar(8)
  contactEmail      String   @map("contact_email") @db.VarChar(191)
  dpoContact        String?  @map("dpo_contact") @db.VarChar(500)
  body              String   @db.Text
  publishedAt       DateTime @default(now()) @map("published_at") @db.DateTime(3)
  publishedByUserId BigInt   @map("published_by_user_id") @db.UnsignedBigInt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "company_privacy_notices_company_fk")
  publishedBy       User     @relation("PrivacyNoticePublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "company_privacy_notices_publisher_fk")
  privacyReceipts   CompanyPrivacyReceipt[]

  @@unique([companyId, version], map: "company_privacy_notices_company_version_uq")
  @@unique([companyId, id], map: "company_privacy_notices_company_id_uq")
  @@map("company_privacy_notices")
}

model CompanyPrivacyReceipt {
  id               BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  companyId        BigInt                @map("company_id") @db.UnsignedBigInt
  partnerId        BigInt                @map("partner_id") @db.UnsignedBigInt
  noticeId         BigInt                @map("notice_id") @db.UnsignedBigInt
  providedAt       DateTime              @map("provided_at") @db.DateTime(3)
  method           PrivacyDeliveryMethod
  recordedByUserId BigInt                @map("recorded_by_user_id") @db.UnsignedBigInt
  recordedAt       DateTime              @default(now()) @map("recorded_at") @db.DateTime(3)
  reason           String?               @db.VarChar(500)
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "company_privacy_receipts_company_fk")
  partner          Partner               @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict, map: "company_privacy_receipts_partner_fk")
  notice           CompanyPrivacyNotice  @relation(fields: [companyId, noticeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict, map: "company_privacy_receipts_notice_fk")
  recordedBy       User                  @relation("PrivacyReceiptRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "company_privacy_receipts_recorder_fk")

  @@index([companyId, partnerId, recordedAt, id], map: "company_privacy_receipts_partner_recorded_idx")
  @@index([companyId, noticeId], map: "company_privacy_receipts_company_notice_idx")
  @@map("company_privacy_receipts")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId  BigInt?  @map("company_id") @db.UnsignedBigInt
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId     BigInt?  @map("user_id") @db.UnsignedBigInt
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   BigInt?  @map("entity_id") @db.UnsignedBigInt
  partnerId  BigInt?  @map("partner_id") @db.UnsignedBigInt
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  reason     String?  @db.VarChar(255)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  partner    Partner? @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([companyId, entityType, entityId, createdAt], map: "audit_logs_company_entity_date_idx")
  @@index([companyId, partnerId, createdAt], map: "audit_logs_company_partner_date_idx")
  @@index([companyId, userId, createdAt], map: "audit_logs_company_user_date_idx")
  @@index([companyId, action, createdAt], map: "audit_logs_company_action_date_idx")
  @@index([companyId, createdAt, id], map: "audit_logs_company_created_idx")
  @@index([userId], map: "audit_logs_user_fk_idx")
  @@map("audit_logs")
}
