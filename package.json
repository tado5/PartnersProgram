{
  "name": "partners-program",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:phase6": "node --import tsx --test tests/phase6.test.ts",
    "test:phase8": "node --import tsx --test tests/phase8.test.ts",
    "test:phase9": "node --import tsx --test tests/phase9.test.ts",
    "test:phase5a": "node tests/run-phase5a.mjs",
    "db:generate": "prisma generate",
    "db:provision": "docker compose exec -T db bash /docker-entrypoint-initdb.d/01-databases-and-users.sh",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:local": "tsx prisma/seed-local-test-users.ts",
    "db:permissions": "docker compose exec -T db bash /docker/grant-app-privileges.sh",
    "badges:close": "tsx scripts/close-monthly-badges.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.0",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5"
  }
}
